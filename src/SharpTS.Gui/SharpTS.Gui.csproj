<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <IsPackable>false</IsPackable>
    <CopyLocalLockFileAssemblies>true</CopyLocalLockFileAssemblies>
    <AssemblyName>SharpTS.Gui</AssemblyName>
    <RootNamespace>SharpTS.Gui</RootNamespace>
    <Description>Retained Avalonia renderer for the SharpTS GUI SDK.</Description>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Avalonia" />
    <PackageReference Include="Avalonia.Controls.ColorPicker" />
    <PackageReference Include="Avalonia.Headless" />
    <PackageReference Include="Avalonia.Skia" />
    <ProjectReference Include="..\SharpTS.Gui.Generator\SharpTS.Gui.Generator.csproj"
                      ReferenceOutputAssembly="false" />
  </ItemGroup>

  <Target Name="VerifyGeneratedGuiControlContract" BeforeTargets="CoreCompile">
    <MSBuild Projects="..\SharpTS.Gui.Generator\SharpTS.Gui.Generator.csproj" Targets="GetTargetPath">
      <Output TaskParameter="TargetOutputs" PropertyName="GuiControlGenerator" />
    </MSBuild>
    <PropertyGroup>
      <GuiControlDotNetHost Condition="'$(DOTNET_HOST_PATH)' != ''">$(DOTNET_HOST_PATH)</GuiControlDotNetHost>
      <GuiControlDotNetHost Condition="'$(GuiControlDotNetHost)' == ''">dotnet</GuiControlDotNetHost>
    </PropertyGroup>
    <Exec Command="&quot;$(GuiControlDotNetHost)&quot; &quot;$(GuiControlGenerator)&quot; verify" />
  </Target>
</Project>
