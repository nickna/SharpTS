<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <GuiHostPublishRoot>..\SharpTS.Gui.Host\bin\Release\net10.0\publish\</GuiHostPublishRoot>
  </PropertyGroup>
  <Import Project="Sdk\SupportedPlatforms.props" />

  <PropertyGroup>
    <IncludeBuildOutput>false</IncludeBuildOutput>
    <SuppressDependenciesWhenPacking>true</SuppressDependenciesWhenPacking>
    <GeneratePackageOnBuild>false</GeneratePackageOnBuild>
    <IsPackable>true</IsPackable>
    <IsPackable Condition="'$(SharpTSGuiSkipPack)' == 'true'">false</IsPackable>
    <PackageId>SharpTS.Gui.Sdk</PackageId>
    <MinVerVersionOverride Condition="'$(MinVerVersionOverride)' == ''">0.1.0-preview.1</MinVerVersionOverride>
    <Description>Public-preview MSBuild SDK for building Windows desktop applications with SharpTS TSX and Avalonia.</Description>
    <PackageTags>typescript;tsx;avalonia;desktop;msbuild;sdk</PackageTags>
    <PackageReadmeFile>readme.md</PackageReadmeFile>
    <DevelopmentDependency>true</DevelopmentDependency>
    <NoPackageAnalysis>true</NoPackageAnalysis>
  </PropertyGroup>

  <ItemGroup>
    <Compile Remove="Launcher\Launcher.cs" />
    <None Include="Sdk\**" Pack="true" PackagePath="Sdk\" />
    <None Include="..\SharpTS.Sdk.Tasks\bin\Release\net10.0\SharpTS.Sdk.Tasks.dll"
          Pack="true"
          PackagePath="build"
          Condition="Exists('..\SharpTS.Sdk.Tasks\bin\Release\net10.0\SharpTS.Sdk.Tasks.dll')" />
    <None Include="GuiPackage\**"
          Exclude="GuiPackage\tsconfig.overlay.json"
          Pack="true"
          PackagePath="gui" />
    <None Include="Launcher\Launcher.cs" Pack="true" PackagePath="launcher" />
    <None Include="$(GuiHostPublishRoot)**"
          Exclude="$(GuiHostPublishRoot)runtimes\**;$(GuiHostPublishRoot)**\*.pdb"
          Pack="true"
          PackagePath="tools/net10.0/any/host/"
          Condition="Exists('$(GuiHostPublishRoot)')" />
    <None Include="@(SharpTSGuiRuntimeAsset)" Pack="true">
      <PackagePath>tools/net10.0/any/host/runtimes/%(RuntimeIdentifier)/</PackagePath>
    </None>
    <None Include="readme.md" Pack="true" PackagePath="\" />
    <None Include="..\LICENSE" Pack="true" PackagePath="\" />
  </ItemGroup>

  <Target Name="EnsureGuiSdkPayloadPresent" BeforeTargets="GenerateNuspec">
    <Error Condition="!Exists('..\SharpTS.Sdk.Tasks\bin\Release\net10.0\SharpTS.Sdk.Tasks.dll')"
           Text="SharpTS.Gui.Sdk pack: tasks assembly missing. Build SharpTS.Sdk.Tasks in Release first." />
    <Error Condition="!Exists('$(GuiHostPublishRoot)SharpTS.Gui.Host.dll')"
           Text="SharpTS.Gui.Sdk pack: host payload missing. Publish the GUI host in Release first." />
    <Error Condition="!Exists('$(GuiHostPublishRoot)SharpTS.dll')"
           Text="SharpTS.Gui.Sdk pack: SharpTS compiler/runtime missing from host payload." />
    <Error Condition="!Exists('$(GuiHostPublishRoot)SharpTS.Gui.dll')"
           Text="SharpTS.Gui.Sdk pack: Avalonia renderer bridge missing from host payload." />
  </Target>
</Project>
