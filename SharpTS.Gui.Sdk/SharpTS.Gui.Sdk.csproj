<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <GuiHostPublishRoot>..\SharpTS.Gui.Host\bin\Release\net10.0\publish\</GuiHostPublishRoot>
    <GuiAotHostPublishRoot>..\SharpTS.Gui.Host\bin\Release\net10.0\aot-publish\</GuiAotHostPublishRoot>
  </PropertyGroup>
  <Import Project="Sdk\SupportedPlatforms.props" />

  <PropertyGroup>
    <IncludeBuildOutput>false</IncludeBuildOutput>
    <SuppressDependenciesWhenPacking>true</SuppressDependenciesWhenPacking>
    <GeneratePackageOnBuild>false</GeneratePackageOnBuild>
    <IsPackable>true</IsPackable>
    <IsPackable Condition="'$(SharpTSGuiSkipPack)' == 'true'">false</IsPackable>
    <PackageId>SharpTS.Gui.Sdk</PackageId>
    <MinVerVersionOverride Condition="'$(MinVerVersionOverride)' == ''">0.3.0-preview.1</MinVerVersionOverride>
    <Description>Preview MSBuild SDK for Windows desktop applications with SharpTS TSX and Avalonia; macOS payloads are experimental candidates.</Description>
    <PackageTags>typescript;tsx;avalonia;desktop;msbuild;sdk</PackageTags>
    <PackageReadmeFile>readme.md</PackageReadmeFile>
    <DevelopmentDependency>true</DevelopmentDependency>
    <NoPackageAnalysis>true</NoPackageAnalysis>
    <NoDefaultExcludes>true</NoDefaultExcludes>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\SharpTS.Gui.Generator\SharpTS.Gui.Generator.csproj"
                      ReferenceOutputAssembly="false" />
    <Compile Remove="Launcher\Launcher.cs" />
    <None Include="Sdk\**" Pack="true" PackagePath="Sdk\" />
    <None Include="..\SharpTS.Sdk.Tasks\bin\Release\net10.0\SharpTS.Sdk.Tasks.dll"
          Pack="true"
          PackagePath="build"
          Condition="Exists('..\SharpTS.Sdk.Tasks\bin\Release\net10.0\SharpTS.Sdk.Tasks.dll')" />
    <None Include="GuiPackage\**"
          Exclude="GuiPackage\tsconfig.overlay.json"
          Pack="true"
          PackagePath="gui" />
    <None Include="Launcher\Launcher.cs" Pack="true" PackagePath="launcher" />
    <None Include="Templates\**\*"
          Exclude="Templates\sharpts-gui\.template.config\template.json"
          Pack="true"
          PackagePath="content\Templates\" />
    <None Include="Templates\sharpts-gui\.template.config\template.json"
          Pack="true"
          PackagePath="content\Templates\sharpts-gui\.template.config\" />
    <None Include="$(GuiHostPublishRoot)**"
          Exclude="$(GuiHostPublishRoot)runtimes\**;$(GuiHostPublishRoot)**\*.pdb"
          Pack="true"
          PackagePath="tools/net10.0/any/host/"
          Condition="Exists('$(GuiHostPublishRoot)')" />
    <None Include="$(GuiAotHostPublishRoot)Avalonia*.dll;
                   $(GuiAotHostPublishRoot)HarfBuzzSharp.dll;
                   $(GuiAotHostPublishRoot)MicroCom.Runtime.dll;
                   $(GuiAotHostPublishRoot)Microsoft.Extensions.DependencyInjection.Abstractions.dll;
                   $(GuiAotHostPublishRoot)SharpTS.Gui.Host.dll;
                   $(GuiAotHostPublishRoot)SharpTS.Gui.dll;
                   $(GuiAotHostPublishRoot)SharpTS.Hosting.Abstractions.dll;
                   $(GuiAotHostPublishRoot)SkiaSharp.dll;
                   $(GuiAotHostPublishRoot)Tmds.DBus.Protocol.dll"
          Pack="true"
          PackagePath="tools/net10.0/any/aot-host/"
          Condition="Exists('$(GuiAotHostPublishRoot)')" />
    <None Include="@(SharpTSGuiRuntimeAsset)" Pack="true">
      <PackagePath>tools/net10.0/any/host/runtimes/%(RuntimeIdentifier)/</PackagePath>
    </None>
    <None Include="readme.md" Pack="true" PackagePath="\" />
    <None Include="..\LICENSE" Pack="true" PackagePath="\" />
  </ItemGroup>

  <Target Name="VerifyGeneratedGuiControlContract" BeforeTargets="CoreCompile">
    <Exec Command="dotnet &quot;$([MSBuild]::NormalizePath('$(MSBuildThisFileDirectory)', '..', 'SharpTS.Gui.Generator', 'bin', '$(Configuration)', 'net10.0', 'SharpTS.Gui.Generator.dll'))&quot; verify" />
  </Target>

  <Target Name="EnsureGuiSdkPayloadPresent"
          BeforeTargets="GenerateNuspec"
          Condition="'$(IsPackable)' == 'true'">
    <Error Condition="!Exists('..\SharpTS.Sdk.Tasks\bin\Release\net10.0\SharpTS.Sdk.Tasks.dll')"
           Text="SharpTS.Gui.Sdk pack: tasks assembly missing. Build SharpTS.Sdk.Tasks in Release first." />
    <Error Condition="!Exists('$(GuiHostPublishRoot)SharpTS.Gui.Host.dll')"
           Text="SharpTS.Gui.Sdk pack: host payload missing. Publish the GUI host in Release first." />
    <Error Condition="!Exists('$(GuiAotHostPublishRoot)SharpTS.Gui.Host.dll')"
           Text="SharpTS.Gui.Sdk pack: AOT host payload missing. Publish the GUI host with SharpTSGuiHostLibrary=true first." />
    <Error Condition="!Exists('$(GuiHostPublishRoot)SharpTS.dll')"
           Text="SharpTS.Gui.Sdk pack: SharpTS compiler/runtime missing from host payload." />
    <Error Condition="!Exists('$(GuiHostPublishRoot)SharpTS.Gui.dll')"
           Text="SharpTS.Gui.Sdk pack: Avalonia renderer bridge missing from host payload." />
  </Target>
</Project>
