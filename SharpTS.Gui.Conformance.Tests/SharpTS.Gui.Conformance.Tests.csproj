<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
    <GuiConformanceHostDir>$(MSBuildThisFileDirectory)..\SharpTS.Gui.Host\bin\$(Configuration)\net10.0\</GuiConformanceHostDir>
    <GuiConformanceCompiler>$(MSBuildThisFileDirectory)..\bin\$(Configuration)\net10.0\SharpTS.dll</GuiConformanceCompiler>
    <GuiConformanceBridge>$(MSBuildThisFileDirectory)..\SharpTS.Gui\bin\$(Configuration)\net10.0\SharpTS.Gui.dll</GuiConformanceBridge>
    <GuiConformanceRoot>$(MSBuildProjectDirectory)\obj\$(Configuration)\net10.0\.sharpts-gui-conformance\</GuiConformanceRoot>
    <GuiConformancePackage>$(GuiConformanceRoot)node_modules\@sharpts\gui\</GuiConformancePackage>
    <GuiConformanceConfig>$(GuiConformanceRoot)tsconfig.json</GuiConformanceConfig>
    <GuiConformanceGuest>$(GuiConformanceRoot)SharpTS.Gui.Guest.dll</GuiConformanceGuest>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Avalonia" />
    <PackageReference Include="Avalonia.Headless" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" />
    <PackageReference Include="xunit" />
    <PackageReference Include="xunit.runner.visualstudio">
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\SharpTS.Gui\SharpTS.Gui.csproj" />
    <ProjectReference Include="..\SharpTS.Gui.Host\SharpTS.Gui.Host.csproj" />
  </ItemGroup>

  <ItemGroup>
    <GuiConformancePackageSource Include="..\SharpTS.Gui.Sdk\GuiPackage\index.ts;..\SharpTS.Gui.Sdk\GuiPackage\internal-testing.ts;..\SharpTS.Gui.Sdk\GuiPackage\jsx-runtime.ts;..\SharpTS.Gui.Sdk\GuiPackage\jsx-dev-runtime.ts;..\SharpTS.Gui.Sdk\GuiPackage\runtime.ts;..\SharpTS.Gui.Sdk\GuiPackage\package.json" />
  </ItemGroup>

  <Target Name="PrepareGuiConformanceHost" AfterTargets="Build">
    <Error Condition="!Exists('$(GuiConformanceHostDir)SharpTS.Gui.Host.dll')" Text="GUI conformance host is missing." />
    <Error Condition="!Exists('$(GuiConformanceCompiler)')" Text="GUI conformance compiler is missing." />
    <MakeDir Directories="$(GuiConformancePackage);$(GuiConformanceHostDir)Guest;$(GuiConformanceHostDir).sharpts\node_modules\@sharpts\gui" />
    <Copy SourceFiles="@(GuiConformancePackageSource)" DestinationFolder="$(GuiConformancePackage)" />
    <Copy SourceFiles="..\SharpTS.Gui.Sdk\GuiPackage\tsconfig.overlay.json" DestinationFiles="$(GuiConformanceConfig)" />
    <Exec Command="dotnet &quot;$(GuiConformanceCompiler)&quot; -p &quot;$(GuiConformanceConfig)&quot; -r &quot;$(GuiConformanceBridge)&quot; -c &quot;$(MSBuildThisFileDirectory)..\SharpTS.Gui.Sdk.Consumer\main.tsx&quot; --target dll --hosted --quiet -o &quot;$(GuiConformanceGuest)&quot;" />
    <Copy SourceFiles="$(GuiConformanceGuest)" DestinationFolder="$(GuiConformanceHostDir)" />
    <Copy SourceFiles="..\SharpTS.Gui.Sdk.Consumer\main.tsx" DestinationFolder="$(GuiConformanceHostDir)Guest" />
    <Copy SourceFiles="$(GuiConformanceConfig)" DestinationFolder="$(GuiConformanceHostDir).sharpts" />
    <Copy SourceFiles="GuiConformanceApp.json" DestinationFiles="$(GuiConformanceHostDir).sharpts\app.json" />
    <Copy SourceFiles="@(GuiConformancePackageSource)" DestinationFolder="$(GuiConformanceHostDir).sharpts\node_modules\@sharpts\gui" />
  </Target>
</Project>
